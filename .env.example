# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay
# KEY_ID and KEY_SECRET must both be test-mode or both be live-mode values.
RAZORPAY_KEY_ID=
