# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay
# KEY_ID and KEY_SECRET must both be test-mode or both be live-mode values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# This is a separate secret configured on the Razorpay webhook. It is not the
# Razorpay API key secret.
RAZORPAY_WEBHOOK_SECRET=

# Google Cloud API key with the Google Slides API enabled. Used server-side to
# read course module decks shared as "Anyone with the link".
GOOGLE_API_KEY=
